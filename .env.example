# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Database (required) ---------------------------------------------------
# MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=conferencehub

# --- Server ----------------------------------------------------------------
# Render sets PORT automatically; 8080 is the local default.
PORT=8080
# `production` hides internal error details and marks the session cookie secure.
NODE_ENV=development
# Allowed browser origin for CORS. Defaults to * when unset.
CORS_ORIGIN=*

# --- Sessions (required once OAuth is enabled) -----------------------------
# Any long random string. Signs the session cookie; changing it logs everyone out.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- GitHub OAuth ----------------------------------------------------------
# Create the app at https://github.com/settings/developers -> New OAuth App.
# The callback URL registered there must match GITHUB_CALLBACK_URL exactly.
#   Local:  http://localhost:8080/auth/github/callback
#   Render: https://<your-service>.onrender.com/auth/github/callback
# When these two keys are empty the API still runs; /auth/github returns 503.
GITHUB_CLIENT_ID=Ov23liur6IiBxC0eqM0g
GITHUB_CLIENT_SECRET=0599d12942052a0104dba279ddb6b875690fa62a
GITHUB_CALLBACK_URL=http://localhost:8080/auth/github/callback

# --- Swagger generation (optional) -----------------------------------------
# Baked into swagger.json by `npm run swagger`. The served spec rewrites both
# values from the incoming request, so these rarely need changing.
SWAGGER_HOST=localhost:8080
SWAGGER_SCHEME=http
