# Copy this file to .env and fill in your own values.
# .env is git-ignored - never commit real credentials.

# --- Database -------------------------------------------------------------
# MongoDB Atlas connection string (free M0 tier)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=conferencehub

# --- Server ---------------------------------------------------------------
# Render sets PORT automatically in production; 8080 is the local default.
PORT=8080
NODE_ENV=development

# Allowed browser origin for CORS. Use '*' locally, the client domain in production.
CORS_ORIGIN=*

# --- Swagger --------------------------------------------------------------
# Baked into swagger.json by `npm run swagger`. The server rewrites host and
# scheme per request, so these only affect the generated file.
SWAGGER_HOST=localhost:8080
SWAGGER_SCHEME=http

# --- Week 06: GitHub OAuth (not used yet) ---------------------------------
# SESSION_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:8080/auth/callback
