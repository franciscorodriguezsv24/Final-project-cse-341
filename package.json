{
  "name": "conferencehub-api",
  "version": "1.0.0",
  "description": "ConferenceHub API - REST API for organizing multi-day conferences (CSE 341 Final Project)",
  "main": "server.js",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "swagger": "node swagger/swagger.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/helpers/"
    ]
  },
  "keywords": [
    "cse341",
    "conference",
    "api",
    "express",
    "mongodb"
  ],
  "author": "Alejandro Rodríguez",
  "license": "MIT",
  "dependencies": {
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "mongodb": "^6.8.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2",
    "swagger-autogen": "^2.23.7"
  }
}
