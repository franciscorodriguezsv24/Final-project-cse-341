{
  "swagger": "2.0",
  "info": {
    "title": "ConferenceHub API",
    "version": "2.0.0",
    "description": "REST API for organizing multi-day conferences and the events inside them. Four collections - events, speakers, sessions and registrations - each with full CRUD, request validation and centralized error handling.\n\n## Authentication\n\n### ➡️ [Sign in with GitHub](/auth/github)\n\nGET routes are public. Every POST, PUT and DELETE requires a sign-in. Use the link above - it navigates this tab to GitHub and brings you straight back here with a session cookie, which Try it out then reuses automatically on the protected routes.\n\nDo **not** press Execute on `GET /auth/github`: that route answers with a redirect to github.com, and a browser will not let this page's JavaScript follow a redirect to another site, so it reports \"Failed to fetch\". The route is working - it simply has to be followed by the browser itself, which is what the link above does.\n\nCheck [/auth/status](/auth/status) to see who you are signed in as, and [/auth/logout](/auth/logout) to end the session. Signed out, protected routes answer 401."
  },
  "host": "localhost:8080",
  "basePath": "/",
  "tags": [
    {
      "name": "Root",
      "description": "Service information and health"
    },
    {
      "name": "Auth",
      "description": "GitHub OAuth login, session status and logout"
    },
    {
      "name": "Events",
      "description": "Conference events (12-field collection)"
    },
    {
      "name": "Speakers",
      "description": "People who present at sessions (8-field collection)"
    },
    {
      "name": "Sessions",
      "description": "Individual talks inside an event (11-field collection)"
    },
    {
      "name": "Registrations",
      "description": "Attendee tickets for an event (9-field collection)"
    }
  ],
  "schemes": [
    "http"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Root"
        ],
        "summary": "API information",
        "description": "Confirms the API is running and points to the documentation and the login route.",
        "responses": {
          "200": {
            "description": "API metadata"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Root"
        ],
        "summary": "Health check",
        "description": "Used by Render to confirm the service is up.",
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        }
      }
    },
    "/auth/github": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Start GitHub OAuth login",
        "description": "### ➡️ [Click here to sign in](/auth/github) <br><br> Do NOT press Execute below. This route answers with a 302 redirect to github.com, and the browser blocks the JavaScript on this page from following a redirect to another site, so Try it out reports \"Failed to fetch\" even though the route worked. Authorization has to be a real browser navigation so you can see github.com in the address bar before entering credentials. Use the link above, approve the app, and GitHub returns you to /auth/github/callback, which creates the session and sends you back to /api-docs.",
        "responses": {
          "302": {
            "description": "Redirect to GitHub for authorization"
          },
          "503": {
            "description": "OAuth is not configured on this server"
          }
        }
      }
    },
    "/auth/github/callback": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "GitHub OAuth callback",
        "description": "GitHub redirects here after the user approves. Creates the session and forwards to the documentation.",
        "responses": {
          "302": {
            "description": "Redirect to /api-docs once signed in"
          }
        }
      }
    },
    "/auth/failure": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "OAuth failure landing route",
        "description": "",
        "responses": {
          "401": {
            "description": "GitHub sign-in was denied or failed"
          }
        }
      }
    },
    "/auth/status": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Who am I",
        "description": "Reports whether the current session is signed in, and who as. Use it to confirm login and logout worked.",
        "responses": {
          "200": {
            "description": "Current authentication state"
          }
        }
      }
    },
    "/auth/logout": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Log out",
        "description": "Clears the Passport login, destroys the session record, and clears the cookie. Afterwards every protected route returns 401 again.",
        "responses": {
          "200": {
            "description": "Signed out"
          }
        }
      }
    },
    "/events/": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Get all events",
        "description": "Returns every event sorted by start date. Optionally filtered by status or category.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Filter by status",
            "required": false,
            "type": "string",
            "enum": [
              "draft",
              "published",
              "cancelled"
            ]
          },
          {
            "name": "category",
            "in": "query",
            "description": "Filter by category",
            "required": false,
            "type": "string",
            "enum": [
              "technology",
              "business",
              "health",
              "education",
              "science",
              "arts",
              "community",
              "other"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "List of events"
          },
          "400": {
            "description": "Validation failed - unknown status or category"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "tags": [
          "Events"
        ],
        "summary": "Create a new event (protected)",
        "description": "Requires a GitHub sign-in at /auth/github. organizerId is optional: when it is omitted the signed-in user becomes the organizer.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Event to create",
            "required": true,
            "schema": {
              "$ref": "#/definitions/EventInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Event created"
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Not signed in"
          }
        }
      }
    },
    "/events/findByCategory": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Find events by category",
        "description": "Returns every event in the requested category, sorted by start date.",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "description": "Category to search for",
            "required": true,
            "type": "string",
            "enum": [
              "technology",
              "business",
              "health",
              "education",
              "science",
              "arts",
              "community",
              "other"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Matching events"
          },
          "400": {
            "description": "Validation failed - category missing or unknown"
          }
        }
      }
    },
    "/events/{eventId}": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Get a single event by id",
        "description": "",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "24-character MongoDB ObjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "The requested event"
          },
          "400": {
            "description": "Validation failed - eventId is not a valid ObjectId"
          },
          "404": {
            "description": "Event not found"
          }
        }
      },
      "put": {
        "tags": [
          "Events"
        ],
        "summary": "Replace an existing event (protected)",
        "description": "Requires a GitHub sign-in at /auth/github. PUT replaces the whole document, so every field is required. createdAt and the original organizer are preserved.",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "24-character MongoDB ObjectId"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Full replacement event",
            "required": true,
            "schema": {
              "$ref": "#/definitions/EventInput"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event updated"
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Not signed in"
          },
          "404": {
            "description": "Event not found"
          }
        }
      },
      "delete": {
        "tags": [
          "Events"
        ],
        "summary": "Delete an event (protected)",
        "description": "Requires a GitHub sign-in at /auth/github. Fails with 409 when sessions or registrations still reference this event.",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "24-character MongoDB ObjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Event deleted"
          },
          "400": {
            "description": "Validation failed - eventId is not a valid ObjectId"
          },
          "401": {
            "description": "Not signed in"
          },
          "404": {
            "description": "Event not found"
          },
          "409": {
            "description": "Event still has sessions or registrations"
          }
        }
      }
    },
    "/events/{eventId}/sessions": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Get every session belonging to an event",
        "description": "The sessions collection is implemented in Week 06; until then this returns an empty list for an existing event.",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "24-character MongoDB ObjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Sessions for this event"
          },
          "400": {
            "description": "Validation failed - eventId is not a valid ObjectId"
          },
          "404": {
            "description": "Event not found"
          }
        }
      }
    },
    "/speakers/": {
      "get": {
        "tags": [
          "Speakers"
        ],
        "summary": "Get all speakers",
        "description": "Returns every speaker sorted by last name. Optionally filtered by organization.",
        "parameters": [
          {
            "name": "organization",
            "in": "query",
            "description": "Filter by exact organization name",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "List of speakers"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "tags": [
          "Speakers"
        ],
        "summary": "Create a new speaker (protected)",
        "description": "Requires a GitHub sign-in at /auth/github.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Speaker to create",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SpeakerInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Speaker created"
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Not signed in"
          },
          "409": {
            "description": "A speaker with that email already exists"
          }
        }
      }
    },
    "/speakers/{speakerId}": {
      "get": {
        "tags": [
          "Speakers"
        ],
        "summary": "Get a single speaker by id",
        "description": "",
        "parameters": [
          {
            "name": "speakerId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "24-character MongoDB ObjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "The requested speaker"
          },
          "400": {
            "description": "Validation failed - speakerId is not a valid ObjectId"
          },
          "404": {
            "description": "Speaker not found"
          }
        }
      },
      "put": {
        "tags": [
          "Speakers"
        ],
        "summary": "Replace an existing speaker (protected)",
        "description": "Requires a GitHub sign-in at /auth/github. PUT replaces the whole document, so every field is required.",
        "parameters": [
          {
            "name": "speakerId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "24-character MongoDB ObjectId"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Full replacement speaker",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SpeakerInput"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Speaker updated"
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Not signed in"
          },
          "404": {
            "description": "Speaker not found"
          },
          "409": {
            "description": "Another speaker already uses that email"
          }
        }
      },
      "delete": {
        "tags": [
          "Speakers"
        ],
        "summary": "Delete a speaker (protected)",
        "description": "Requires a GitHub sign-in at /auth/github. Fails with 409 when sessions are still assigned to this speaker.",
        "parameters": [
          {
            "name": "speakerId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "24-character MongoDB ObjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Speaker deleted"
          },
          "400": {
            "description": "Validation failed - speakerId is not a valid ObjectId"
          },
          "401": {
            "description": "Not signed in"
          },
          "404": {
            "description": "Speaker not found"
          },
          "409": {
            "description": "Speaker is still assigned to sessions"
          }
        }
      }
    },
    "/speakers/{speakerId}/sessions": {
      "get": {
        "tags": [
          "Speakers"
        ],
        "summary": "Get every session assigned to a speaker",
        "description": "The sessions collection is implemented in Week 06; until then this returns an empty list for an existing speaker.",
        "parameters": [
          {
            "name": "speakerId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "24-character MongoDB ObjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Sessions for this speaker"
          },
          "400": {
            "description": "Validation failed - speakerId is not a valid ObjectId"
          },
          "404": {
            "description": "Speaker not found"
          }
        }
      }
    },
    "/sessions/": {
      "get": {
        "tags": [
          "Sessions"
        ],
        "summary": "Get all sessions",
        "description": "Returns every session sorted by start time. Optionally filtered by event, speaker or track.",
        "parameters": [
          {
            "name": "eventId",
            "in": "query",
            "description": "Only sessions belonging to this event",
            "required": false,
            "type": "string"
          },
          {
            "name": "speakerId",
            "in": "query",
            "description": "Only sessions given by this speaker",
            "required": false,
            "type": "string"
          },
          {
            "name": "track",
            "in": "query",
            "description": "Filter by track",
            "required": false,
            "type": "string",
            "enum": [
              "general",
              "frontend",
              "backend",
              "cloud",
              "data",
              "career",
              "workshop"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "List of sessions"
          },
          "400": {
            "description": "Validation failed - unknown track or malformed id"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "tags": [
          "Sessions"
        ],
        "summary": "Create a new session (protected)",
        "description": "Requires a GitHub sign-in at /auth/github. The referenced event and speaker must exist, and the room must be free for the whole time slot.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Session to create",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SessionInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Session created"
          },
          "400": {
            "description": "Validation failed, or eventId/speakerId does not exist"
          },
          "401": {
            "description": "Not signed in"
          },
          "409": {
            "description": "The room is already booked for that time slot"
          }
        }
      }
    },
    "/sessions/{sessionId}": {
      "get": {
        "tags": [
          "Sessions"
        ],
        "summary": "Get a single session by id",
        "description": "",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "24-character MongoDB ObjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "The requested session"
          },
          "400": {
            "description": "Validation failed - sessionId is not a valid ObjectId"
          },
          "404": {
            "description": "Session not found"
          }
        }
      },
      "put": {
        "tags": [
          "Sessions"
        ],
        "summary": "Replace an existing session (protected)",
        "description": "Requires a GitHub sign-in at /auth/github. PUT replaces the whole document, so every field is required. createdAt is preserved from the original record.",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "24-character MongoDB ObjectId"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Full replacement session",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SessionInput"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session updated"
          },
          "400": {
            "description": "Validation failed, or eventId/speakerId does not exist"
          },
          "401": {
            "description": "Not signed in"
          },
          "404": {
            "description": "Session not found"
          },
          "409": {
            "description": "The room is already booked for that time slot"
          }
        }
      },
      "delete": {
        "tags": [
          "Sessions"
        ],
        "summary": "Delete a session (protected)",
        "description": "Requires a GitHub sign-in at /auth/github.",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "24-character MongoDB ObjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Session deleted"
          },
          "400": {
            "description": "Validation failed - sessionId is not a valid ObjectId"
          },
          "401": {
            "description": "Not signed in"
          },
          "404": {
            "description": "Session not found"
          }
        }
      }
    },
    "/registrations/": {
      "get": {
        "tags": [
          "Registrations"
        ],
        "summary": "Get all registrations",
        "description": "Returns every registration, newest first. Optionally filtered by event, status or attendee email.",
        "parameters": [
          {
            "name": "eventId",
            "in": "query",
            "description": "Only registrations for this event",
            "required": false,
            "type": "string"
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by status",
            "required": false,
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "cancelled"
            ]
          },
          {
            "name": "attendeeEmail",
            "in": "query",
            "description": "Only registrations held by this email address",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "List of registrations"
          },
          "400": {
            "description": "Validation failed - unknown status or malformed id or email"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "tags": [
          "Registrations"
        ],
        "summary": "Create a new registration (protected)",
        "description": "Requires a GitHub sign-in at /auth/github. The event must exist, the attendee must not already be registered for it, and enough seats must remain.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Registration to create",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RegistrationInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Registration created"
          },
          "400": {
            "description": "Validation failed, or eventId does not exist"
          },
          "401": {
            "description": "Not signed in"
          },
          "409": {
            "description": "Duplicate attendee email for the event, or the event is sold out"
          }
        }
      }
    },
    "/registrations/{registrationId}": {
      "get": {
        "tags": [
          "Registrations"
        ],
        "summary": "Get a single registration by id",
        "description": "",
        "parameters": [
          {
            "name": "registrationId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "24-character MongoDB ObjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "The requested registration"
          },
          "400": {
            "description": "Validation failed - registrationId is not a valid ObjectId"
          },
          "404": {
            "description": "Registration not found"
          }
        }
      },
      "put": {
        "tags": [
          "Registrations"
        ],
        "summary": "Replace an existing registration (protected)",
        "description": "Requires a GitHub sign-in at /auth/github. PUT replaces the whole document, so every field is required. registeredAt is preserved from the original record.",
        "parameters": [
          {
            "name": "registrationId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "24-character MongoDB ObjectId"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Full replacement registration",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RegistrationInput"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Registration updated"
          },
          "400": {
            "description": "Validation failed, or eventId does not exist"
          },
          "401": {
            "description": "Not signed in"
          },
          "404": {
            "description": "Registration not found"
          },
          "409": {
            "description": "Duplicate attendee email for the event, or not enough seats remain"
          }
        }
      },
      "delete": {
        "tags": [
          "Registrations"
        ],
        "summary": "Delete a registration (protected)",
        "description": "Requires a GitHub sign-in at /auth/github. Deleting releases the seats back to the event.",
        "parameters": [
          {
            "name": "registrationId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "24-character MongoDB ObjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Registration deleted"
          },
          "400": {
            "description": "Validation failed - registrationId is not a valid ObjectId"
          },
          "401": {
            "description": "Not signed in"
          },
          "404": {
            "description": "Registration not found"
          }
        }
      }
    }
  },
  "definitions": {
    "EventInput": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "example": "BYU Pathway Developer Summit 2026"
        },
        "description": {
          "type": "string",
          "example": "A three-day conference covering web development, cloud infrastructure and career growth."
        },
        "startDate": {
