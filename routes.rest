### ConferenceHub API - manual tests for the VS Code REST Client extension
### Switch @host between local and production to run the same suite against either.

@host = http://localhost:8080
# @host = https://conferencehub-api.onrender.com

### Root - service information (also reports whether you are signed in)
GET {{host}}/

### Health check
GET {{host}}/health

###############################################################################
# AUTH
#
# GET routes are public. Every POST, PUT and DELETE needs a session cookie.
#
# To get one:
#   1. Open {{host}}/auth/github in a browser and approve the app.
#   2. In DevTools -> Application -> Cookies, copy the `conferencehub.sid` value.
#   3. Paste it into @sid below (the value only, not the name).
#
# The write requests in this file already send it as a Cookie header.
###############################################################################

@sid = paste-the-conferencehub.sid-cookie-value-here
@cookie = conferencehub.sid={{sid}}

### Who am I (200 - authenticated true or false)
GET {{host}}/auth/status

### Start the GitHub login (open this one in a browser, not here)
GET {{host}}/auth/github

### Log out (200)
GET {{host}}/auth/logout

### Any write without the cookie (401)
POST {{host}}/speakers
Content-Type: application/json

{ "firstName": "Nobody" }

###############################################################################
# SPEAKERS
###############################################################################

### Create a speaker (201)
# @name createSpeaker
POST {{host}}/speakers
Content-Type: application/json
Cookie: {{cookie}}

{
  "firstName": "Marta",
  "lastName": "Contreras",
  "email": "marta.contreras@example.com",
  "organization": "Northwind Labs",
  "jobTitle": "Principal Engineer",
  "bio": "Marta has spent twelve years building distributed systems and teaches backend design.",
  "photoUrl": "https://example.com/photos/marta-contreras.jpg"
}

### Capture the id returned above for the requests that follow
@speakerId = {{createSpeaker.response.body.data._id}}

### Get all speakers
GET {{host}}/speakers

### Filter speakers by organization
GET {{host}}/speakers?organization=Northwind Labs

### Get one speaker
GET {{host}}/speakers/{{speakerId}}

### Sessions for a speaker
GET {{host}}/speakers/{{speakerId}}/sessions

### Replace a speaker (200)
PUT {{host}}/speakers/{{speakerId}}
Content-Type: application/json
Cookie: {{cookie}}

{
  "firstName": "Marta",
  "lastName": "Contreras-Diaz",
  "email": "marta.contreras@example.com",
  "organization": "Northwind Labs",
  "jobTitle": "Distinguished Engineer",
  "bio": "Marta has spent twelve years building distributed systems and teaches backend design.",
  "photoUrl": "https://example.com/photos/marta-v2.jpg"
}

### Delete a speaker (200)
DELETE {{host}}/speakers/{{speakerId}}
Cookie: {{cookie}}

###############################################################################
# SPEAKERS - error cases
###############################################################################

### Validation failure: several bad fields at once (400)
POST {{host}}/speakers
Content-Type: application/json
Cookie: {{cookie}}

{
  "firstName": "M",
  "email": "not-an-email",
  "photoUrl": "ftp://wrong-protocol"
}

### Duplicate email (409) - run the create request twice
POST {{host}}/speakers
Content-Type: application/json
Cookie: {{cookie}}

{
  "firstName": "Marta",
  "lastName": "Contreras",
  "email": "marta.contreras@example.com",
  "organization": "Northwind Labs",
  "jobTitle": "Principal Engineer",
  "bio": "Marta has spent twelve years building distributed systems and teaches backend design.",
  "photoUrl": "https://example.com/photos/marta-contreras.jpg"
}

### Malformed ObjectId (400)
GET {{host}}/speakers/not-a-valid-id

### Well formed but missing id (404)
GET {{host}}/speakers/66b0f2c8a1d4e5f60912ab99

###############################################################################
# EVENTS
###############################################################################

### Create an event (201) - organizerId is omitted, so the signed-in user owns it
# @name createEvent
POST {{host}}/events
Content-Type: application/json
Cookie: {{cookie}}

{
  "title": "BYU Pathway Developer Summit 2026",
  "description": "A three-day conference covering web development, cloud infrastructure and career growth.",
  "startDate": "2026-09-14T09:00:00.000Z",
  "endDate": "2026-09-16T17:00:00.000Z",
  "location": "Salt Palace Convention Center, Salt Lake City, UT",
  "capacity": 500,
  "category": "technology",
  "ticketPrice": 149.99,
  "status": "published"
}

### Capture the id returned above
@eventId = {{createEvent.response.body.data._id}}

### Get all events
GET {{host}}/events

### Filter events by status and category
GET {{host}}/events?status=published&category=technology

### Find events by category (dedicated route)
GET {{host}}/events/findByCategory?category=technology

### Get one event
GET {{host}}/events/{{eventId}}

### Sessions for an event
GET {{host}}/events/{{eventId}}/sessions

### Replace an event (200) - createdAt and the organizer are preserved
PUT {{host}}/events/{{eventId}}
Content-Type: application/json
Cookie: {{cookie}}

{
  "title": "BYU Pathway Developer Summit 2026 (Updated)",
  "description": "A three-day conference covering web development, cloud infrastructure and career growth.",
  "startDate": "2026-09-14T09:00:00.000Z",
  "endDate": "2026-09-16T17:00:00.000Z",
  "location": "Salt Palace Convention Center, Salt Lake City, UT",
  "capacity": 750,
  "category": "technology",
  "ticketPrice": 179.99,
  "status": "published"
}

###############################################################################
# EVENTS - error cases
###############################################################################

### Missing and invalid fields (400)
POST {{host}}/events
Content-Type: application/json
Cookie: {{cookie}}

{
  "title": "No",
  "capacity": -5,
  "category": "underwater-basket-weaving",
  "status": "somethingelse"
}

### endDate before startDate (400, cross-field rule)
POST {{host}}/events
Content-Type: application/json
Cookie: {{cookie}}

{
  "title": "Backwards Conference",
  "description": "This event ends before it begins, which the validator must reject.",
  "startDate": "2026-09-16T09:00:00.000Z",
  "endDate": "2026-09-14T17:00:00.000Z",
  "location": "Nowhere, UT",
  "capacity": 10,
  "category": "technology",
  "ticketPrice": 0,
  "status": "draft"
}

### Unknown query value (400)
GET {{host}}/events?status=bogus

### Malformed JSON body (400)
POST {{host}}/events
Content-Type: application/json
Cookie: {{cookie}}

{ "title": "broken",, }

###############################################################################
# SESSIONS
###############################################################################

### Create a session (201) - needs a real eventId and speakerId
# @name createSession
POST {{host}}/sessions
Content-Type: application/json
Cookie: {{cookie}}

{
  "eventId": "{{eventId}}",
  "speakerId": "{{speakerId}}",
  "title": "Designing REST APIs that survive contact with real clients",
  "description": "A practical hour on resource modelling, status codes, validation and the errors that only show up in production.",
  "startTime": "2026-09-14T10:00:00.000Z",
  "endTime": "2026-09-14T11:00:00.000Z",
  "room": "Hall B",
  "track": "backend",
  "capacity": 120
}

### Capture the id returned above
@sessionId = {{createSession.response.body.data._id}}

### Get all sessions
GET {{host}}/sessions

### Filter sessions by event
GET {{host}}/sessions?eventId={{eventId}}

### Filter sessions by track
GET {{host}}/sessions?track=backend

### Get one session
GET {{host}}/sessions/{{sessionId}}

### Replace a session (200)
PUT {{host}}/sessions/{{sessionId}}
Content-Type: application/json
Cookie: {{cookie}}

{
  "eventId": "{{eventId}}",
  "speakerId": "{{speakerId}}",
  "title": "Designing REST APIs that survive contact with real clients",
  "description": "A practical hour on resource modelling, status codes, validation and the errors that only show up in production.",
  "startTime": "2026-09-14T10:00:00.000Z",
  "endTime": "2026-09-14T12:00:00.000Z",
  "room": "Hall C",
  "track": "backend",
  "capacity": 200
}

### Delete a session (200)
DELETE {{host}}/sessions/{{sessionId}}
Cookie: {{cookie}}

###############################################################################
# SESSIONS - error cases
###############################################################################

### endTime before startTime (400, cross-field rule)
POST {{host}}/sessions
Content-Type: application/json
Cookie: {{cookie}}

{
  "eventId": "{{eventId}}",
  "speakerId": "{{speakerId}}",
  "title": "Time-travelling talk",
  "description": "This talk ends before it begins, which the validator must reject.",
  "startTime": "2026-09-14T11:00:00.000Z",
  "endTime": "2026-09-14T10:00:00.000Z",
  "room": "Hall B",
  "track": "general",
  "capacity": 50
}

### References that do not exist (400, both fields reported at once)
POST {{host}}/sessions
Content-Type: application/json
Cookie: {{cookie}}

{
  "eventId": "66b0f2c8a1d4e5f60912ab99",
  "speakerId": "66b0f2c8a1d4e5f60912ab98",
  "title": "Talk with no event and no speaker",
  "description": "Both references point at documents that do not exist in the database.",
  "startTime": "2026-09-14T10:00:00.000Z",
  "endTime": "2026-09-14T11:00:00.000Z",
  "room": "Hall B",
  "track": "general",
  "capacity": 50
}

### Room double-booking (409) - run the create session request twice
POST {{host}}/sessions
Content-Type: application/json
Cookie: {{cookie}}

{
  "eventId": "{{eventId}}",
  "speakerId": "{{speakerId}}",
  "title": "A different talk in the same room at the same time",
  "description": "The room conflict rule must reject this because Hall B is already taken.",
  "startTime": "2026-09-14T10:30:00.000Z",
  "endTime": "2026-09-14T11:30:00.000Z",
  "room": "Hall B",
  "track": "general",
  "capacity": 50
}

### Unknown track (400)
GET {{host}}/sessions?track=basket-weaving

###############################################################################
# REGISTRATIONS
###############################################################################

### Create a registration (201)
# @name createRegistration
POST {{host}}/registrations
Content-Type: application/json
Cookie: {{cookie}}

{
  "eventId": "{{eventId}}",
  "attendeeName": "Diego Salazar",
  "attendeeEmail": "diego.salazar@example.com",
  "ticketType": "general",
  "quantity": 2,
  "amountPaid": 299.98,
  "status": "confirmed"
}

### Capture the id returned above
@registrationId = {{createRegistration.response.body.data._id}}

### Get all registrations
GET {{host}}/registrations

### Filter registrations by event
GET {{host}}/registrations?eventId={{eventId}}

### Filter registrations by status
GET {{host}}/registrations?status=confirmed

### Get one registration
GET {{host}}/registrations/{{registrationId}}

### Replace a registration (200) - registeredAt is preserved
PUT {{host}}/registrations/{{registrationId}}
Content-Type: application/json
Cookie: {{cookie}}

{
  "eventId": "{{eventId}}",
  "attendeeName": "Diego Salazar",
  "attendeeEmail": "diego.salazar@example.com",
  "ticketType": "vip",
  "quantity": 3,
  "amountPaid": 599.97,
  "status": "confirmed"
}

### Delete a registration (200) - releases the seats back to the event
DELETE {{host}}/registrations/{{registrationId}}
Cookie: {{cookie}}

